#include <windows.h>
#include "resource.h"

IDD_CONFIG DIALOGEX 0, 0, 316, 290
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Discord Rich Presence - Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    CONTROL         "Enable Discord Rich Presence", IDC_ENABLED, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 8, 160, 10

    LTEXT           "Discord application ID:", -1, 10, 26, 90, 8
    EDITTEXT        IDC_CLIENT_ID, 104, 24, 144, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Get one...", IDC_OPEN_PORTAL, 254, 23, 52, 14

    LTEXT           "Create an application at discord.com/developers, then paste its ID above.",
                    IDC_STATUS_TEXT, 10, 40, 296, 8

    LTEXT           "Shown as:", -1, 10, 58, 90, 8
    COMBOBOX        IDC_ACTIVITY_TYPE, 104, 56, 144, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "Application name:", -1, 10, 76, 90, 8
    EDITTEXT        IDC_ACTIVITY_NAME, 104, 74, 144, 12, ES_AUTOHSCROLL

    LTEXT           "Member list shows:", -1, 10, 94, 90, 8
    COMBOBOX        IDC_STATUS_DISPLAY, 104, 92, 144, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Cover art", -1, 10, 114, 296, 96
    CONTROL         "Show cover art", IDC_ALBUM_ART,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 128, 200, 10
    CONTROL         "Use the artwork stored in the file (uploads it so Discord can fetch it)",
                    IDC_EMBEDDED_ART, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 142, 266, 10
    CONTROL         "Otherwise look the release up online (iTunes, then Deezer)",
                    IDC_ONLINE_LOOKUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 30, 156, 266, 10

    LTEXT           "Upload to:", -1, 30, 172, 46, 8
    COMBOBOX        IDC_UPLOAD_HOST, 80, 170, 216, 80,
                    CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    LTEXT           "No cover image:", -1, 30, 190, 55, 8
    EDITTEXT        IDC_FALLBACK_IMAGE, 88, 188, 156, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_FALLBACK, 248, 187, 48, 14

    GROUPBOX        "Playback", -1, 10, 216, 296, 42
    CONTROL         "Show playback progress bar", IDC_PROGRESS_BAR,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 230, 266, 10
    CONTROL         "Keep status visible while paused", IDC_SHOW_PAUSED,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 244, 266, 10

    CONTROL         "Write a debug log next to the settings file", IDC_LOGGING,
                    "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 266, 220, 10

    DEFPUSHBUTTON   "OK", IDOK, 200, 268, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 256, 268, 50, 14
END
